<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/colorPrimaryDark">
    <ImageView android:id="@+id/splashLogo" android:layout_width="130dp" android:layout_height="130dp"
        android:src="@mipmap/ic_launcher_round" android:contentDescription="Logo"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/splashTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/white"
        android:layout_marginTop="20dp" android:alpha="0"
        app:layout_constraintTop_toBottomOf="@id/splashLogo" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/splashSub" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/app_description" android:textSize="13sp" android:textColor="#B0BEC5"
        android:layout_marginTop="8dp" android:alpha="0"
        app:layout_constraintTop_toBottomOf="@id/splashTitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <ProgressBar android:id="@+id/splashProgress" android:layout_width="28dp" android:layout_height="28dp"
        android:layout_marginBottom="40dp" android:indeterminateTint="@color/white" android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
